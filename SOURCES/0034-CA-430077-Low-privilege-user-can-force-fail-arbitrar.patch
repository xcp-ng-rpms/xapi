From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ming Lu <ming.lu@citrix.com>
Date: Mon, 2 Nov 2026 11:14:16 +0000
Subject: [PATCH] CA-430077: Low-privilege user can force-fail arbitrary tasks
 via task_id parameter

A low-privilege user could use [task_id] parameter in some APIs to set
other users' tasks failed. So now setting a task failed only if the task
is owned by the user (caller).

For a call or request, the check can be placed in the following 3
places alternatively:
1. Xapi_http.assert_credentials_ok if rbac_check is true in HTTP
   actions;
2. Server_helpers.do_dispatch if the call is a regular XenAPI call;
3. others by calling Xapi_http.with_context. This is a best-to-have
   place in case a call or request doesn't go to the 2 places above.

This is CVE-2026-119779, part of XSA-530.

Signed-off-by: Ming Lu <ming.lu@citrix.com>
Reviewed-by: Andrii Sultanov <andriy.sultanov@vates.tech>
---
 ocaml/xapi/server_helpers.ml  | 26 +++++++++++++++++++++++
 ocaml/xapi/server_helpers.mli |  7 +++++++
 ocaml/xapi/taskHelper.ml      | 20 +++++++++++-------
 ocaml/xapi/xapi_http.ml       | 39 +++++++++++++++++++++--------------
 4 files changed, 69 insertions(+), 23 deletions(-)

diff --git a/ocaml/xapi/server_helpers.ml b/ocaml/xapi/server_helpers.ml
index 0fe9383c7..af831a29d 100644
--- a/ocaml/xapi/server_helpers.ml
+++ b/ocaml/xapi/server_helpers.ml
@@ -120,6 +120,18 @@ module Helper = struct
   end)
 end
 
+let can_own_task ?session_id task_id =
+  try
+    Context.with_context ~quiet:true ?session_id "can_own_task"
+      (fun __context -> TaskHelper.assert_op_valid ~__context task_id
+    ) ;
+    true
+  with e ->
+    warn "Task %s provided in the request can't be handled by the caller: %s"
+      (Ref.string_of task_id)
+      (ExnHelper.string_of_exn e) ;
+    false
+
 let do_dispatch ?session_id ?forward_op ?self:_ supports_async called_fn_name
     op_fn marshaller fd http_req label sync_ty generate_task_for =
   (* if the call has been forwarded to us, then they are responsible for completing the task, so we don't need to complete it *)
@@ -134,6 +146,20 @@ let do_dispatch ?session_id ?forward_op ?self:_ supports_async called_fn_name
       Context.of_http_req ?session_id ~internal_async_subtask ~generate_task_for
         ~supports_async ~label ~http_req ~fd ()
     in
+    if
+      Context.task_in_database __context
+      && not (can_own_task ?session_id (Context.get_task_id __context))
+    then
+      raise
+        Api_errors.(
+          Server_error
+            ( rbac_permission_denied
+            , [
+                String.lowercase_ascii called_fn_name
+              ; "The task provided in the request belongs to another subject."
+              ]
+            )
+        ) ;
 
     Constants.when_tgroups_enabled (fun () ->
         let identity =
diff --git a/ocaml/xapi/server_helpers.mli b/ocaml/xapi/server_helpers.mli
index 6651402ac..131531a32 100644
--- a/ocaml/xapi/server_helpers.mli
+++ b/ocaml/xapi/server_helpers.mli
@@ -39,6 +39,13 @@ val exec_with_subtask :
   -> (__context:Context.t -> 'b)
   -> 'b
 
+val can_own_task : ?session_id:API.ref_session -> API.ref_task -> bool
+(** [can_own_task ?session_id task] is true when [session_id] can handle
+    [task]. A task provided by a request is caller-controlled, so it has to be
+    checked before anything is done with it. Only call this for a task
+    that is really in the database: the check cannot resolve a dummy ref and
+    would refuse every unprivileged caller. *)
+
 (* used by auto-generated code in server.ml *)
 val my_assoc : string -> (string * 'a) list -> 'a
 
