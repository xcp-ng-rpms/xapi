diff --git a/ocaml-nbd/unix/nbd_unix.ml b/ocaml-nbd/unix/nbd_unix.ml
new file mode 100644
index 000000000..1f3805597
--- /dev/null
+++ b/ocaml-nbd/unix/nbd_unix.ml
@@ -0,0 +1,143 @@
+(*
