From b836c4233b9fef0ae78c2343a205b6110abecae1 Mon Sep 17 00:00:00 2001
From: Andrii Sultanov <andriy.sultanov@vates.tech>
Date: Thu, 23 Jul 2026 10:47:31 +0000
Subject: [PATCH] Add ktls-helper/dune to install ktls-helper binary

Signed-off-by: Andrii Sultanov <andriy.sultanov@vates.tech>
---
 ocaml/ktls-helper/dune | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)
 create mode 100644 ocaml/ktls-helper/dune

diff --git a/ocaml/ktls-helper/dune b/ocaml/ktls-helper/dune
new file mode 100644
index 000000000..fe7a7b0a5
--- /dev/null
+++ b/ocaml/ktls-helper/dune
@@ -0,0 +1,21 @@
+(data_only_dirs helper)
+
+(rule
+  (deps (source_tree helper))
+  (targets ktls-helper)
+  (action
+    (no-infer
+      (progn
+        (chdir helper (run make))
+        (copy helper/ktls-helper ktls-helper)
+      )
+    )
+  )
+)
+
+(install
+  (package xapi-tools)
+  (section libexec_root)
+  (files (ktls-helper as ktls-helper))
+)
+
