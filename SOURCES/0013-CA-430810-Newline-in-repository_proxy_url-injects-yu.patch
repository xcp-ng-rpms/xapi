From e6a88d65c0ead1a4d92fb07608c2bd1086076d30 Mon Sep 17 00:00:00 2001
From: Ming Lu <ming.lu@citrix.com>
Date: Mon, 2 Nov 2026 19:20:43 +0800
Subject: [PATCH 13/13] CA-430810: Newline in repository_proxy_url injects
 yum/dnf .repo directives

Add sanity check in the URLs, proxy username and password configured for YUM/DNF.

This is CVE-2026-119780, part of XSA-530.

Signed-off-by: Ming Lu <ming.lu@citrix.com>
Reviewed-by: Andrii Sultanov <andriy.sultanov@vates.tech>
---
 ocaml/tests/test_repository_helpers.ml | 91 ++++++++++++++++++++++++++
 ocaml/xapi/repository.ml               | 10 ++-
 ocaml/xapi/repository_helpers.ml       | 15 +++++
 ocaml/xapi/xapi_pool.ml                |  7 +-
 4 files changed, 120 insertions(+), 3 deletions(-)

diff --git a/ocaml/tests/test_repository_helpers.ml b/ocaml/tests/test_repository_helpers.ml
index c3e0dffef3..d0185ee6dc 100644
--- a/ocaml/tests/test_repository_helpers.ml
+++ b/ocaml/tests/test_repository_helpers.ml
@@ -243,20 +243,110 @@ module AssertUrlIsValid = Generic.MakeStateless (struct
       ; ( ("http://a.b.cc.com", ["c.com"; "d.com"])
         , Error
             Api_errors.(Server_error (invalid_base_url, ["http://a.b.cc.com"]))
         )
       ; (("http://a.b.c.com//", ["c.com"; "d.com"]), Ok ())
       ; (("http://a.b.c.com/a/b", ["c.com"; "d.com"]), Ok ())
       ; (("http://a.b.c.com/a/b/", ["c.com"; "d.com"]), Ok ())
       ; (("https://a.b.d.com//", ["c.com"; "d.com"]), Ok ())
       ; (("https://a.b.d.com/a/b", ["c.com"; "d.com"]), Ok ())
       ; (("https://a.b.d.com/a/b/", ["c.com"; "d.com"]), Ok ())
+      ; (* control characters are rejected wherever they appear *)
+        ( ("http://a.b.c.com/a\n/b", ["c.com"])
+        , Error
+            Api_errors.(
+              Server_error (invalid_base_url, ["http://a.b.c.com/a\n/b"])
+            )
+        )
+      ; ( ("http://a.b.c.com\r\nX-Injected: 1", ["c.com"])
+        , Error
+            Api_errors.(
+              Server_error
+                (invalid_base_url, ["http://a.b.c.com\r\nX-Injected: 1"])
+            )
+        )
+      ; ( ("http://a.b.c\000.com", ["c.com"])
+        , Error
+            Api_errors.(
+              Server_error (invalid_base_url, ["http://a.b.c\000.com"])
+            )
+        )
+      ; ( ("http://a.b.c.com/\127", ["c.com"])
+        , Error
+            Api_errors.(
+              Server_error (invalid_base_url, ["http://a.b.c.com/\127"])
+            )
+        )
+      ; ( ("\thttp://a.b.c.com", ["c.com"])
+        , Error
+            Api_errors.(Server_error (invalid_base_url, ["\thttp://a.b.c.com"]))
+        )
+      ]
+end)
+
+module AssertRemotePoolUrlIsValid = Generic.MakeStateless (struct
+  module Io = struct
+    type input_t = string
+
+    type output_t = (unit, exn) result
+
+    let string_of_input_t = Fmt.(str "%a" Dump.string)
+
+    let string_of_output_t =
+      Fmt.(str "%a" Dump.(result ~ok:(any "()") ~error:exn))
+  end
+
+  let transform url =
+    try Ok (assert_remote_pool_url_is_valid ~url) with e -> Error e
+
+  let invalid url = Error Api_errors.(Server_error (invalid_base_url, [url]))
+
+  let tests =
+    `QuickAndAutoDocumented
+      [
+        ("https://192.168.0.2/repository/enabled", Ok ())
+      ; ("https://[::1]/repository/enabled", Ok ())
+      ; (* wrong scheme, host or path *)
+        ( "http://192.168.0.2/repository/enabled"
+        , invalid "http://192.168.0.2/repository/enabled"
+        )
+      ; ( "https://a.b.c.com/repository/enabled"
+        , invalid "https://a.b.c.com/repository/enabled"
+        )
+      ; ( "https://192.168.0.2/repository"
+        , invalid "https://192.168.0.2/repository"
+        )
+      ; (* a newline terminates Uri.path, so the shape check on its own would
+           accept these and the trailing lines would reach the .repo file *)
+        ( "https://192.168.0.2/repository/enabled\n\
+           [evil]\n\
+           baseurl=http://attacker/"
+        , invalid
+            "https://192.168.0.2/repository/enabled\n\
+             [evil]\n\
+             baseurl=http://attacker/"
+        )
+      ; ( "https://192.168.0.2/repository/enabled\nproxy=http://attacker:3128"
+        , invalid
+            "https://192.168.0.2/repository/enabled\nproxy=http://attacker:3128"
+        )
+      ; (* other control characters, which the shape check already rejected but
+           which must keep reporting the same error *)
+        ( "https://192.168.0.2/repository/enabled\r\nX-Injected: 1"
+        , invalid "https://192.168.0.2/repository/enabled\r\nX-Injected: 1"
+        )
+      ; ( "https://192.168.0.2\000/repository/enabled"
+        , invalid "https://192.168.0.2\000/repository/enabled"
+        )
+      ; ( "\thttps://192.168.0.2/repository/enabled"
+        , invalid "\thttps://192.168.0.2/repository/enabled"
+        )
       ]
 end)
 
 module AssertUrlIsNotBlocked = Generic.MakeStateless (struct
   module Io = struct
     type input_t = string * string list
 
     type output_t = (unit, exn) result
 
     let string_of_input_t = Fmt.(str "%a" Dump.(pair string (list string)))
@@ -5509,20 +5599,21 @@ module GetAccumulativeLivepatches = Generic.MakeStateless (struct
           ]
         )
       ]
 end)
 
 let tests =
   make_suite "repository_helpers_"
     [
       ("update_of_json", UpdateOfJsonTest.tests)
     ; ("assert_url_is_valid", AssertUrlIsValid.tests)
+    ; ("assert_remote_pool_url_is_valid", AssertRemotePoolUrlIsValid.tests)
     ; ("assert_url_is_not_blocked", AssertUrlIsNotBlocked.tests)
     ; ("write_yum_config", WriteYumConfig.tests)
     ; ("eval_guidance_for_one_update", EvalGuidanceForOneUpdate.tests)
     ; ("get_update_in_json", GetUpdateInJson.tests)
     ; ("consolidate_updates_of_host", ConsolidateUpdatesOfHost.tests)
     ; ("parse_updateinfo_list", ParseUpdateInfoList.tests)
     ; ("guidance_set_resort", GuidanceSetResortTest.tests)
     ; ("guidance_set_reduce", GuidanceSetReduceTest.tests)
     ; ( "guidance_set_reduce_cascaded_list"
       , GuidanceSetReduceCascadedListTest.tests
diff --git a/ocaml/xapi/repository.ml b/ocaml/xapi/repository.ml
index e567afbd6f..8a48fc337c 100644
--- a/ocaml/xapi/repository.ml
+++ b/ocaml/xapi/repository.ml
@@ -133,25 +133,31 @@ let cleanup_pool_repo ~__context ~self =
 let get_proxy_params ~__context =
   let pool = Helpers.get_pool ~__context in
   let url = Db.Pool.get_repository_proxy_url ~__context ~self:pool in
   let username = Db.Pool.get_repository_proxy_username ~__context ~self:pool in
   let password_ref =
     Db.Pool.get_repository_proxy_password ~__context ~self:pool
   in
   match (url, username, password_ref) with
   | url', username', password_ref'
     when url' <> "" && username' <> "" && password_ref' <> Ref.null ->
+      let password = Db.Secret.get_value ~__context ~self:password_ref' in
+      (* The secret value may change after being configured. Re-check it again. *)
+      if has_control_character password then (
+        error
+          "The password of the repository proxy contains control character(s)" ;
+        raise Api_errors.(Server_error (invalid_repository_proxy_credential, []))
+      ) ;
       [
         Printf.sprintf "proxy=%s" url'
       ; Printf.sprintf "proxy_username=%s" username'
-      ; Printf.sprintf "proxy_password=%s"
-          (Db.Secret.get_value ~__context ~self:password_ref')
+      ; Printf.sprintf "proxy_password=%s" password
       ]
   | url', "", _ when url' <> "" ->
       [Printf.sprintf "proxy=%s" url']
   | _ ->
       []
 
 let sync ~__context ~self ~token ~token_id ~username ~password =
   try
     let repo_name = get_remote_repository_name ~__context ~self in
     remove_repo_conf_file repo_name ;
diff --git a/ocaml/xapi/repository_helpers.ml b/ocaml/xapi/repository_helpers.ml
index e32b49a420..68c4aa753f 100644
--- a/ocaml/xapi/repository_helpers.ml
+++ b/ocaml/xapi/repository_helpers.ml
@@ -151,21 +151,35 @@ module DomainNameIncludeIP = struct
     try host_exn t
     with Invalid_argument _ -> (
       match Ipaddr.of_string (Domain_name.to_string t) with
       | Ok ip ->
           Ipaddr.to_domain_name ip
       | Error _ ->
           invalid_arg "invalid host name"
     )
 end
 
+let has_control_character s =
+  let is_control_character c =
+    let code = Char.code c in
+    code < 0x20 || code = 0x7f
+  in
+  String.exists is_control_character s
+
+let assert_no_control_chars ~url ~url_error =
+  if has_control_character url then (
+    error "Invalid url: it contains control character(s)" ;
+    raise Api_errors.(Server_error (url_error, [url]))
+  )
+
 let assert_url_is_valid ~url =
+  assert_no_control_chars ~url ~url_error:Api_errors.invalid_base_url ;
   try
     let uri = Uri.of_string url in
     match Uri.(scheme uri, host uri) with
     | Some ("http" | "https"), Some h -> (
         let subdomain =
           DomainNameIncludeIP.(host_exn (of_string h |> Result.get_ok))
         in
         let invalids, valids =
           List.partition_map
             (fun d ->
@@ -252,20 +266,21 @@ let get_remote_pool_coordinator_ip url =
   | Some "https", Some host, path
     when path = Constants.get_enabled_repository_uri
          && Helpers.is_valid_ip `ipv4or6 host ->
       host
   | _ ->
       error "Invalid url: %s, expected url format: %s" url
         ("https://<coordinator-ip>" ^ Constants.get_enabled_repository_uri) ;
       raise Api_errors.(Server_error (invalid_base_url, [url]))
 
 let assert_remote_pool_url_is_valid ~url =
+  assert_no_control_chars ~url ~url_error:Api_errors.invalid_base_url ;
   ignore (get_remote_pool_coordinator_ip url : string)
 
 let with_pool_repositories f =
   Xapi_stdext_pervasives.Pervasiveext.finally
     (fun () ->
       Mutex.lock pool_update_ops_mutex ;
       f ()
     )
     (fun () -> Mutex.unlock pool_update_ops_mutex)
 
diff --git a/ocaml/xapi/xapi_pool.ml b/ocaml/xapi/xapi_pool.ml
index 77b2d867c9..839b499f98 100644
--- a/ocaml/xapi/xapi_pool.ml
+++ b/ocaml/xapi/xapi_pool.ml
@@ -4252,27 +4252,32 @@ let configure_repository_proxy ~__context ~self ~url ~username ~password =
       raise Api_errors.(Server_error (invalid_repository_proxy_url, [url]))
   ) ;
   ( match (username, password) with
   | "", p when p <> "" ->
       error "missing username of the repository proxy with a password specified" ;
       raise Api_errors.(Server_error (invalid_repository_proxy_credential, []))
   | u, "" when u <> "" ->
       error "missing password of the repository proxy with a username specified" ;
       raise Api_errors.(Server_error (invalid_repository_proxy_credential, []))
   | u, p when u <> "" && p <> "" ->
-      if String.contains u '\n' || String.contains p '\n' then (
+      if
+        Repository_helpers.has_control_character u
+        || Repository_helpers.has_control_character p
+      then (
         error "getting invalid username/password of the repository proxy" ;
         raise Api_errors.(Server_error (invalid_repository_proxy_credential, []))
       )
   | _ ->
       ()
   ) ;
+  Repository_helpers.assert_no_control_chars ~url
+    ~url_error:Api_errors.invalid_repository_proxy_url ;
   let old_secret_ref = Db.Pool.get_repository_proxy_password ~__context ~self in
   let secret_ref =
     if password = "" then
       Ref.null
     else
       Xapi_secret.create ~__context ~value:password ~other_config:[]
   in
   Db.Pool.set_repository_proxy_url ~__context ~self ~value:url ;
   Db.Pool.set_repository_proxy_username ~__context ~self ~value:username ;
   Db.Pool.set_repository_proxy_password ~__context ~self ~value:secret_ref ;
