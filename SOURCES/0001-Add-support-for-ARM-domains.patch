@@ -146,8 +146,19 @@ module type MEMORY_MODEL_DATA = sig
   val shim_mib : int64 -> int64
 
   val can_start_ballooned_down : bool
+
+  val shadow_pages : int64 -> int -> int64
+  (** Pages needed for the shadow (or P2M) pool of a domain with the given
+      static max (MiB) and vCPU count, before the shadow multiplier is
+      applied *)
 end
 
+let default_shadow_pages static_max_mib vcpu_count =
+  let vcpu_pages = 256L *** Int64.of_int vcpu_count in
+  let p2m_map_pages = static_max_mib in
+  let shadow_resident_pages = static_max_mib in
+  vcpu_pages +++ p2m_map_pages +++ shadow_resident_pages
+
 module HVM_memory_model_data : MEMORY_MODEL_DATA = struct
   let extra_internal_mib = 1L
 
@@ -156,6 +167,8 @@ module HVM_memory_model_data : MEMORY_MODEL_DATA = struct
   let shim_mib _ = 0L
 
   let can_start_ballooned_down = true
+
+  let shadow_pages = default_shadow_pages
 end
 
 module Linux_memory_model_data : MEMORY_MODEL_DATA = struct
@@ -166,6 +179,8 @@ module Linux_memory_model_data : MEMORY_MODEL_DATA = struct
   let shim_mib _ = 0L
 
   let can_start_ballooned_down = true
+
+  let shadow_pages = default_shadow_pages
 end
 
 module PVinPVH_memory_model_data : MEMORY_MODEL_DATA = struct
@@ -176,6 +191,26 @@ module PVinPVH_memory_model_data : MEMORY_MODEL_DATA = struct
   let shim_mib static_max_mib = 23L +++ (static_max_mib /// 90L)
 
   let can_start_ballooned_down = true
+
+  let shadow_pages = default_shadow_pages
+end
+
+module ARM_memory_model_data : MEMORY_MODEL_DATA = struct
+  let extra_internal_mib = 1L
+
+  let extra_external_mib = 1L
+
+  let shim_mib _ = 0L
+
+  let can_start_ballooned_down = false
+
+  (* The "shadow" allocation is the P2M pool holding the stage-2 tables. Size
+     it like libxl__get_required_paging_memory() does for ARM: 256 pages per
+     vCPU, 1 page per MiB of RAM for the P2M, and 128 pages for the extended
+     regions (EXTRA_DEFAULT_PAGING_MEM_MB). There is no shadow paging on ARM,
+     so no shadow resident pages. *)
+  let shadow_pages static_max_mib vcpu_count =
+    (256L *** Int64.of_int vcpu_count) +++ static_max_mib +++ 128L
 end
 
 type memory_config = {
@@ -204,11 +239,8 @@ module Memory_model (D : MEMORY_MODEL_DATA) = struct
     static_max_mib +++ xen_max_offset_mib +++ D.shim_mib static_max_mib
 
   let shadow_mib static_max_mib vcpu_count multiplier =
-    let vcpu_pages = 256L *** Int64.of_int vcpu_count in
-    let p2m_map_pages = static_max_mib in
-    let shadow_resident_pages = static_max_mib in
