From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrii Sultanov <andriy.sultanov@vates.tech>
Date: Mon, 2 Nov 2026 11:08:01 +0000
Subject: [PATCH] CA-430074: Network.create lets vm-admin reconfigure dom0 IP
 and HIMN listener

The minimum allowed role of invoking Network.create is vm-admin. But the
[other_config] map of a Network object (except the key specified by
[map_keys_roles]) are of minimum role of pool-operator. So the [other_config]
parameter of Network.create should be checked to not allow two
particular keys which might impact the host internal management network
(HIMN) when the caller of the API is of vm-admin role. The HIMN is
allowed to be managed with pool-operator or higher privilege levels.

Additionally, there is another path (import) to get the privilege
escalation happen.

This is CVE-2026-102707, part of XSA-530.

Signed-off-by: Ming Lu <ming.lu@citrix.com>
Reviewed-by: Andrii Sultanov <andriy.sultanov@vates.tech>
---
 ocaml/idl/datamodel.ml             |  5 +++++
 ocaml/xapi/import.ml               | 11 +++++++++++
 ocaml/xapi/xapi_network.ml         |  2 ++
 ocaml/xapi/xapi_network_helpers.ml |  5 +++++
 4 files changed, 23 insertions(+)

diff --git a/ocaml/idl/datamodel.ml b/ocaml/idl/datamodel.ml
index 0ed9e361f..b0718cb91 100644
--- a/ocaml/idl/datamodel.ml
+++ b/ocaml/idl/datamodel.ml
@@ -2003,6 +2003,11 @@ module Network = struct
                   ("folder", _R_VM_OP)
                 ; ("XenCenter.CustomFields.*", _R_VM_OP)
                 ; ("XenCenterCreateInProgress", _R_VM_OP)
+                ; (* Host Internal Management Network markers. Redundant for
+                     the writer_roles, but they generate the per-key rules that
+                     Network.create checks, its default role being VM admin. *)
+                  ("is_guest_installer_network", _R_POOL_OP)
+                ; ("is_host_internal_management_network", _R_POOL_OP)
                 ]
               ~lifecycle:[(Published, rel_rio, "additional configuration")]
           ; field
diff --git a/ocaml/xapi/import.ml b/ocaml/xapi/import.ml
index 527197189..f053478b5 100644
--- a/ocaml/xapi/import.ml
+++ b/ocaml/xapi/import.ml
@@ -1255,6 +1255,17 @@ module Net : HandlerTools = struct
     | Found_net _ ->
         handle_dry_run __context config rpc session_id state x precheck_result
     | Create net_record ->
+        (* The [session_id] passed to Client.Network.create_from_record
+           (and hence to Network.create) may have been created by
+           Helpers.call_api_functions with a higher privilege level than the
+           requesting client session. This is intentional, but it means the
+           per-key RBAC check inside Network.create would evaluate that
+           elevated session and let protected keys through. The import
+           metadata is caller-controlled, so enforce the check here instead,
+           where Helpers.assert_map_with_rbac can still resolve the
+           originating session. *)
+        Xapi_network_helpers.assert_protected_map_keys_allowed ~__context
+          ~field_name:"other_config" ~value:net_record.API.network_other_config ;
         let net =
           log_reraise
             ("failed to create Network with name_label "
diff --git a/ocaml/xapi/xapi_network.ml b/ocaml/xapi/xapi_network.ml
index c2329074d..7943dca46 100644
--- a/ocaml/xapi/xapi_network.ml
+++ b/ocaml/xapi/xapi_network.ml
@@ -236,6 +236,8 @@ let rec choose_bridge_name bridges =
 
 let create ~__context ~name_label ~name_description ~mTU ~other_config ~bridge
     ~managed ~tags =
+  Xapi_network_helpers.assert_protected_map_keys_allowed ~__context
+    ~field_name:"other_config" ~value:other_config ;
   with_lock mutex (fun () ->
       let networks = Db.Network.get_all ~__context in
       let bridges =
diff --git a/ocaml/xapi/xapi_network_helpers.ml b/ocaml/xapi/xapi_network_helpers.ml
index 0a6bcd47c..0e1932abf 100644
--- a/ocaml/xapi/xapi_network_helpers.ml
+++ b/ocaml/xapi/xapi_network_helpers.ml
@@ -123,3 +123,8 @@ let assert_network_compatible_with_sriov ~__context ~pif ~network =
                 )
             )
   )
+
+let assert_protected_map_keys_allowed ~__context ~field_name ~value =
+  let match_protected = Helpers.match_protected_key "network" in
+  Helpers.assert_map_with_rbac ~__context ~match_protected
+    ~object_name:"network" ~field_name ~value
