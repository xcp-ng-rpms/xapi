diff --git a/ocaml/xapi/xapi_vm_clone.ml b/ocaml/xapi/xapi_vm_clone.ml
index 25a30eac2..ea76589db 100644
--- a/ocaml/xapi/xapi_vm_clone.ml
+++ b/ocaml/xapi/xapi_vm_clone.ml
@@ -419,10 +419,23 @@ let copy_vm_record ?snapshot_info_record ~__context ~vm ~disk_op ~new_name
 let make_driver_params () =
   [(Constants._sm_epoch_hint, Uuidx.to_string (Uuidx.make ()))]
 
+let assert_protected_map_keys_allowed ~__context ~vm disk_op =
+  match disk_op with
+  | Disk_op_clone | Disk_op_copy _ ->
+      Xapi_vm_helpers.assert_protected_map_keys_allowed ~__context
+        ~field_name:"other_config"
+        ~value:(Db.VM.get_other_config ~__context ~self:vm) ;
+      Xapi_vm_helpers.assert_protected_map_keys_allowed ~__context
+        ~field_name:"platform"
+        ~value:(Db.VM.get_platform ~__context ~self:vm)
+  | Disk_op_snapshot | Disk_op_checkpoint ->
+      ()
+
 (* NB this function may be called when the VM is suspended for copy/clone
    operations. Snapshot can be done in live. *)
 let clone ?snapshot_info_record ?(ignore_vdis = []) disk_op ~__context ~vm
     ~new_name =
+  assert_protected_map_keys_allowed ~__context ~vm disk_op ;
   Helpers.call_api_functions ~__context (fun rpc session_id ->
       let task_id = Ref.string_of (Context.get_task_id __context) in
       let vbds = Db.VM.get_VBDs ~__context ~self:vm in
