From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julian Vetter <julian.vetter@vates.tech>
Date: Tue, 10 Nov 2026 11:41:42 +0100
Subject: [PATCH] xen: restrict qemu nic_type, boot order and keymap from
 VM.platform

Besides hvm_serial, several other VM.platform / HVM boot keys are passed
through to the qemu device model while qemu is still running as root in
dom0. These are:

- nic_type: qemu -device <value>,...
- order: qemu -boot order=<value>
- keymap: qemu -k <value>

On XCP-ng nic_type is reachable by a vm-admin whenever the platform-key
filter is disabled and all three can also come back from a restored VM
image.

Validate them against allowlists: nic_type against the emulated NIC
models xenopsd supports, boot order against boot-device letters, and
keymap against a plain layout name. Anything else is rejected. The
checks are applied at the XAPI configuration point and in xenopsd.

Signed-off-by: Julian Vetter <julian.vetter@vates.tech>

diff --git a/ocaml/xapi/xapi_xenops.ml b/ocaml/xapi/xapi_xenops.ml
index 34aac7a7b9bc..400301b8f431 100644
--- a/ocaml/xapi/xapi_xenops.ml
+++ b/ocaml/xapi/xapi_xenops.ml
@@ -464,7 +464,26 @@ let builder_of_vm ~__context (vmref, vm) timeoffset pci_passthrough vgpu =
              Vm_platform.assert_valid_hvm_serial ~field:"other_config" value ;
              Some value
         )
-    ; keymap= List.assoc_opt "keymap" vm.API.vM_platform
+    ; keymap=
+        (* platform:keymap - Restrict it to a plain layout name *)
+        ( match List.assoc_opt "keymap" vm.API.vM_platform with
+        | Some k
+          when not
+                 (k <> ""
+                 && String.for_all
+                      (function
+                        | 'a' .. 'z' | 'A' .. 'Z' | '0' .. '9' | '-' ->
+                            true
+                        | _ ->
+                            false
+                        )
+                      k
+                 ) ->
+            raise
+              Api_errors.(Server_error (invalid_value, ["platform:keymap"; k]))
+        | k ->
+            k
+        )
     ; vnc_ip= None (*None PR-1255*)
     ; pci_emulations
     ; pci_passthrough
@@ -472,8 +491,24 @@ let builder_of_vm ~__context (vmref, vm) timeoffset pci_passthrough vgpu =
         (* XSI-804 avoid boot orders which are the empty string, as qemu
          * will silently fail to start the VM *)
         (let open Constants in
-         assume_default_if_null_empty vm.API.vM_HVM_boot_params
-           hvm_default_boot_order hvm_boot_params_order
+         let order =
+           assume_default_if_null_empty vm.API.vM_HVM_boot_params
+             hvm_default_boot_order hvm_boot_params_order
+         in
+         (* "order=" ^ order is concatenated into qemu's [-boot] argument, so
+            reject anything but boot-device letters. *)
+         if
+           not
+             (String.for_all
+                (function 'a' .. 'z' | 'A' .. 'Z' -> true | _ -> false)
+                order
+             )
+         then
+           raise
+             Api_errors.(
+               Server_error (invalid_value, ["HVM_boot_params:order"; order])
+             ) ;
+         order
         )
     ; qemu_disk_cmdline= bool vm.API.vM_platform false "qemu_disk_cmdline"
     ; qemu_stubdom= false (* Obsolete: implementation removed *)
diff --git a/ocaml/xenopsd/xc/device.ml b/ocaml/xenopsd/xc/device.ml
index 13d8e32d1a3a..84fc8b73285d 100644
--- a/ocaml/xenopsd/xc/device.ml
+++ b/ocaml/xenopsd/xc/device.ml
@@ -2229,7 +2229,27 @@ module Dm_Common = struct
             )
       in
       let vnc_opt = ["-vnc"; vnc_arg] in
-      let keymap_opt = match keymap with Some k -> ["-k"; k] | None -> [] in
+      (* [-k <keymap>] - Restrict to a plain layout name *)
+      let keymap_opt =
+        match keymap with
+        | Some k
+          when not
+                 (k <> ""
+                 && String.for_all
+                      (function
+                        | 'a' .. 'z' | 'A' .. 'Z' | '0' .. '9' | '-' ->
+                            true
+                        | _ ->
+                            false
+                        )
+                      k
+                 ) ->
+            raise (Ioemu_failed ("keymap", sprintf "invalid keymap %S" k))
+        | Some k ->
+            ["-k"; k]
+        | None ->
+            []
+      in
       List.concat [unused_opt; vnc_opt; keymap_opt]
     in
     let disp_options, wait_for_port =
@@ -3440,6 +3460,18 @@ module Backend = struct
           try xs.Xs.read (sprintf "/local/domain/%d/platform/nic_type" domid)
           with _ -> Config.NIC.default
         in
+        (* platform:nic_type - Reject any unknown NIC type *)
+        let () =
+          let valid_nic_types = ["rtl8139"; "e1000"] in
+          if not (List.mem nic_type valid_nic_types) then
+            raise
+              (Ioemu_failed
+                 ( sprintf "domid %d" domid
+                 , sprintf "Unknown platform:nic_type=%s in device-model=%s"
+                     nic_type Config.name
+                 )
+              )
+        in
         let disk_type =
           try xs.Xs.read (sprintf "/local/domain/%d/platform/disk_type" domid)
           with _ -> Config.DISK.default
@@ -3487,6 +3519,22 @@ module Backend = struct
               []
           with _ -> []
         in
+        (* "order=" - Restrict it to boot-device letters. *)
+        let () =
+          if
+            not
+              (String.for_all
+                 (function 'a' .. 'z' | 'A' .. 'Z' -> true | _ -> false)
+                 info.Dm_Common.boot
+              )
+          then
+            raise
+              (Ioemu_failed
+                 ( sprintf "domid %d" domid
+                 , sprintf "invalid boot order %S" info.Dm_Common.boot
+                 )
+              )
+        in
         let misc =
           List.concat
             [
