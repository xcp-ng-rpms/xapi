diff --git a/ocaml/xenopsd/lib/xenops_server.ml b/ocaml/xenopsd/lib/xenops_server.ml
index 98c26b65c2e1..3fcdb0365809 100644
--- a/ocaml/xenopsd/lib/xenops_server.ml
+++ b/ocaml/xenopsd/lib/xenops_server.ml
@@ -2044,15 +2044,18 @@ let rec perform_atomic ~progress_callback ?result (op : atomic)
         match ipv4_configuration with
         | Vif.Unspecified4 ->
             "None"
-        | Vif.Static4 (address, gateway) -> (
-          match gateway with
-          | None ->
-              Printf.sprintf "Static: address:%s" (String.concat "; " address)
-          | Some value ->
-              Printf.sprintf "Static: address:%s gateway:%s"
-                (String.concat "; " address)
-                value
-        )
+        | Vif.Static4 (address, gateway, dns) ->
+            let address_str = String.concat "; " address in
+            let gateway_str =
+              match gateway with
