       ~ipv6_configuration_mode:all.API.vIF_ipv6_configuration_mode
       ~ipv6_addresses:all.API.vIF_ipv6_addresses
       ~ipv6_gateway:all.API.vIF_ipv6_gateway ~trunks:all.API.vIF_trunks
