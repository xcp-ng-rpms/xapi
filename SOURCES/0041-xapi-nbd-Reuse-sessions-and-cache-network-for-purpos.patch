From 481fd4d5bd98aef4017d4b142f3d07d16b99685e Mon Sep 17 00:00:00 2001
From: Andrii Sultanov <andriy.sultanov@vates.tech>
Date: Tue, 4 Aug 2026 10:46:55 +0000
Subject: [PATCH] xapi-nbd: Reuse sessions and cache network for purpose query

This avoids creating a new session for every connection and querying every
single network just to find out the first one with

    purpose = `nbd | `insecure_nbd

Signed-off-by: Andrii Sultanov <andriy.sultanov@vates.tech>
---
 ocaml/nbd/lib/dune                  |  2 +
 ocaml/nbd/lib/local_xapi_session.ml | 50 +++++++++++++++++--
 ocaml/nbd/src/dune                  |  2 +
 ocaml/nbd/src/main.ml               | 74 ++++++++++++++++++++++-------
 4 files changed, 106 insertions(+), 22 deletions(-)

diff --git a/ocaml/nbd/lib/dune b/ocaml/nbd/lib/dune
index 8feb56e1e..a635eb8d3 100644
--- a/ocaml/nbd/lib/dune
+++ b/ocaml/nbd/lib/dune
@@ -18,6 +18,8 @@
   unix
   xapi-types
   xen-api-client-lwt
+  xapi-stdext-threads
+  threads.posix
  )
 )
 
diff --git a/ocaml/nbd/lib/local_xapi_session.ml b/ocaml/nbd/lib/local_xapi_session.ml
index 08167ad6e..c0e22a1dd 100644
--- a/ocaml/nbd/lib/local_xapi_session.ml
+++ b/ocaml/nbd/lib/local_xapi_session.ml
@@ -15,8 +15,29 @@
 open Lwt.Infix
 module Xen_api = Xen_api_client_lwt.Xen_api_lwt_unix
 
+let cached_session : API.ref_session option ref = ref None
+
+let session_lock = Mutex.create ()
+
+let with_session_lock f =
+  Xapi_stdext_threads.Threadext.Mutex.execute session_lock f
+
+let rpc = Xen_api.make Consts.xapi_unix_domain_socket_uri
+
+let is_valid_session session_id =
+  Lwt.catch
+    (fun () ->
+      (* Call an API function to check the session is still valid *)
+      ignore (Xen_api.Pool.get_all ~rpc ~session_id) ;
+      Lwt.return true
+    )
+    (fun e ->
+      Lwt_log.notice_f "%s: Invalid session: %s" __FUNCTION__
+        (Printexc.to_string e)
+      >>= fun () -> Lwt.return false
+    )
+
 let wait_for_xapi_and_login () =
-  let rpc = Xen_api.make Consts.xapi_unix_domain_socket_uri in
   let rec loop () =
     Lwt.catch
       (fun () ->
@@ -45,11 +66,32 @@ let wait_for_xapi_and_login () =
   Lwt_log.notice_f
     "Will try to log in via xapi's Unix domain socket for %f seconds"
     Consts.wait_for_xapi_timeout_seconds
-  >>= fun () ->
-  Lwt.pick [loop (); timeout ()] >|= fun session_id -> (rpc, session_id)
+  >>= fun () -> Lwt.pick [loop (); timeout ()]
 
 let with_session f =
-  wait_for_xapi_and_login () >>= fun (rpc, session_id) ->
+  let rec get_session () =
+    match !cached_session with
+    | Some session ->
+        is_valid_session session >>= fun valid ->
+        if valid then
+          Lwt.return session
+        else (
+          with_session_lock (fun () -> cached_session := None) ;
+          (get_session [@tailcall]) ()
+        )
+    | None ->
+        wait_for_xapi_and_login () >>= fun new_session ->
+        with_session_lock (fun () ->
+            match !cached_session with
+            | None ->
+                cached_session := Some new_session ;
+                Lwt.return new_session
+            | Some session ->
+                Xen_api.Session.logout ~rpc ~session_id:new_session
+                >>= fun () -> Lwt.return session
+        )
+  in
+  get_session () >>= fun session_id ->
   Lwt.finalize
     (fun () -> f rpc session_id)
     (fun () -> Xen_api.Session.logout ~rpc ~session_id)
