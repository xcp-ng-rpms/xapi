diff --git a/ocaml/nbd/src/main.ml b/ocaml/nbd/src/main.ml
index 944b4d4cb..0be9855fa 100644
--- a/ocaml/nbd/src/main.ml
+++ b/ocaml/nbd/src/main.ml
@@ -97,33 +97,71 @@ let init_tls_get_server_ctx ~certfile =
        )
     )
 
-let xapi_says_use_tls () =
-  let refuse log msg = log msg >>= fun () -> Lwt.fail_with msg in
-  let ask_xapi rpc session_id =
-    let timer = Mtime_clock.counter () in
+(* TODO: would be great if the security of NBD connections was a pool setting
+   and not per-network (since that's what's already de facto enforced *)
+(* Reuses the session and caches the network that had `nbd | `insecure_nbd
+   purpose to avoid querying all network records on every connection *)
+let xapi_says_use_tls =
+  let xapi_says_use_tls_inner rpc session_id =
+    let refuse log msg = log msg >>= fun () -> Lwt.fail_with msg in
     Xen_api.Network.get_all_records ~rpc ~session_id >>= fun all_nets ->
-    let all_porpoises =
-      List.concat_map (fun (_str, net) -> net.API.network_purpose) all_nets
+    let all_purposes =
+      List.map (fun (str, net) -> (net.API.network_purpose, str)) all_nets
+    in
+    let tls =
+      List.find_opt (fun (purpose, _) -> List.mem `nbd purpose) all_purposes
+    in
+    let no_tls =
+      List.find_opt
+        (fun (purpose, _) -> List.mem `insecure_nbd purpose)
+        all_purposes
     in
-    let tls = List.mem `nbd all_porpoises in
-    let no_tls = List.mem `insecure_nbd all_porpoises in
-    Lwt_log.notice_f "xapi_says_use_tls took %f seconds"
-      (Mtime_clock.count timer |> Mtime.Span.to_float_ns |> fun ns -> ns *. 1e-9)
-    >>= fun () ->
     match (tls, no_tls) with
-    | true, true ->
+    | Some (_, _), Some (_, _) ->
         refuse Lwt_log.error
           "Contradictory XenServer configuration: nbd and insecure_nbd network \
            purposes! Refusing connection."
-    | true, false ->
-        Lwt.return true
-    | false, true ->
-        Lwt.return false
-    | false, false ->
+    | Some (_, network), None ->
+        Lwt.return (true, network)
+    | None, Some (_, network) ->
+        Lwt.return (false, network)
+    | None, None ->
         refuse Lwt_log.warning
           "Refusing connection: no network has purpose nbd or insecure_nbd:"
   in
-  Local_xapi_session.with_session ask_xapi
+  let cached_network = ref None in
+  let cached_network_m = Mutex.create () in
+  let with_network_lock f =
+    Xapi_stdext_threads.Threadext.Mutex.execute cached_network_m f
+  in
+  fun () ->
+    let timer = Mtime_clock.counter () in
+    let check_cache rpc session_id =
+      match !cached_network with
+      | Some network -> (
+          Xen_api.Network.get_purpose ~rpc ~session_id ~self:network
+          >>= fun purpose ->
+          let tls = List.mem `nbd purpose in
+          let no_tls = List.mem `insecure_nbd purpose in
+          match (tls, no_tls) with
+          | true, false ->
+              Lwt.return true
+          | false, true ->
+              Lwt.return false
+          | _ ->
+              xapi_says_use_tls_inner rpc session_id >>= fun (tls, network) ->
+              with_network_lock (fun () -> cached_network := Some network) ;
+              Lwt.return tls
+        )
+      | None ->
+          xapi_says_use_tls_inner rpc session_id >>= fun (tls, network) ->
+          with_network_lock (fun () -> cached_network := Some network) ;
+          Lwt.return tls
+    in
+    Local_xapi_session.with_session check_cache >>= fun res ->
+    Lwt_log.notice_f "xapi_says_use_tls took %f seconds"
+      (Mtime_clock.count timer |> Mtime.Span.to_float_ns |> fun ns -> ns *. 1e-9)
+    >>= fun () -> Lwt.return res
 
 let main port certfile connection_limit _ =
   let t () =
