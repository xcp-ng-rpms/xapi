From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Seb Hinderer <sebastien.hinderer@vates.tech>
Date: Mon, 9 Nov 2026 16:16:16 +0100
Subject: [PATCH 44/44] Add the domain ID to the VM lifecycle messages creating
 a domain
Content-Type: text/plain; charset="utf-8"

Append ", domid: <domid>" to the body of the VM_STARTED, VM_RESUMED,
VM_REBOOTED and VM_MIGRATED messages, which follow the creation of a
new domain for the VM. VM.domid is up to date in the database when
these messages are created.

A domain ID only identifies a domain on a given host, and VM_REBOOTED
did not name the host: append it too, before the domain ID.

Signed-off-by: Seb Hinderer <sebastien.hinderer@vates.tech>
---
 ocaml/tests/test_vm_message.ml | 26 ++++++++++++++++--------
 ocaml/xapi/vm_message.ml       | 37 ++++++++++++++++++++++++++++------
 2 files changed, 49 insertions(+), 14 deletions(-)

diff --git a/ocaml/tests/test_vm_message.ml b/ocaml/tests/test_vm_message.ml
index f32b17d151..937c6d6621 100644
--- a/ocaml/tests/test_vm_message.ml
+++ b/ocaml/tests/test_vm_message.ml
@@ -20,10 +20,12 @@ let make_vm ~__context ~name_label ~uuid =
 let test_bodies () =
   let __context = Test_common.make_test_database () in
   let vm = make_vm ~__context ~name_label:"vm" ~uuid:"vm-uuid" in
+  Db.VM.set_domid ~__context ~self:vm ~value:12L ;
   let other = make_vm ~__context ~name_label:"other" ~uuid:"other-uuid" in
   let host =
     Test_common.make_host ~__context ~name_label:"h" ~uuid:"h-uuid" ()
   in
+  Db.VM.set_resident_on ~__context ~self:vm ~value:host ;
   let source_host =
     Test_common.make_host ~__context ~name_label:"src" ~uuid:"src-uuid" ()
   in
@@ -35,9 +37,11 @@ let test_bodies () =
     (body ~__context ~vm (Snapshotted {snapshot_name= "snap"})) ;
   check "checkpoint" "VM 'vm' (uuid: vm-uuid) checkpointed, snapshot name: snap"
     (body ~__context ~vm (Checkpointed {snapshot_name= "snap"})) ;
-  check "start" "VM 'vm' (uuid: vm-uuid) started on host: h (uuid: h-uuid)"
+  check "start"
+    "VM 'vm' (uuid: vm-uuid) started on host: h (uuid: h-uuid), domid: 12"
     (body ~__context ~vm (Started {host})) ;
-  check "start_on" "VM 'vm' (uuid: vm-uuid) started on host: h (uuid: h-uuid)"
+  check "start_on"
+    "VM 'vm' (uuid: vm-uuid) started on host: h (uuid: h-uuid), domid: 12"
     (body ~__context ~vm (Started {host})) ;
   check "pause" "VM 'vm' (uuid: vm-uuid) paused" (body ~__context ~vm Paused) ;
   check "unpause" "VM 'vm' (uuid: vm-uuid) unpaused"
@@ -46,11 +50,15 @@ let test_bodies () =
     (body ~__context ~vm (Shutdown {forced= false})) ;
   check "shutdown" "VM 'vm' (uuid: vm-uuid) shutdown"
     (body ~__context ~vm (Shutdown {forced= false})) ;
-  check "clean_reboot" "VM 'vm' (uuid: vm-uuid) rebooted cleanly"
+  check "clean_reboot"
+    "VM 'vm' (uuid: vm-uuid) rebooted cleanly, host: h (uuid: h-uuid), domid: \
+     12"
     (body ~__context ~vm (Rebooted {forced= false})) ;
   check "hard_shutdown" "VM 'vm' (uuid: vm-uuid) shutdown forcibly"
     (body ~__context ~vm (Shutdown {forced= true})) ;
-  check "hard_reboot" "VM 'vm' (uuid: vm-uuid) rebooted forcibly"
+  check "hard_reboot"
+    "VM 'vm' (uuid: vm-uuid) rebooted forcibly, host: h (uuid: h-uuid), domid: \
+     12"
     (body ~__context ~vm (Rebooted {forced= true})) ;
   check "suspend" "VM 'vm' (uuid: vm-uuid) suspended"
     (body ~__context ~vm Suspended) ;
@@ -59,17 +67,19 @@ let test_bodies () =
     (body ~__context ~vm (Snapshot_reverted {snapshot= other})) ;
   check "csvm" "VM 'vm' (uuid: vm-uuid) cloned (new uuid: other-uuid)"
     (body ~__context ~vm (Cloned {clone= other})) ;
-  check "resume" "VM 'vm' (uuid: vm-uuid) resumed on host: h (uuid: h-uuid)"
+  check "resume"
+    "VM 'vm' (uuid: vm-uuid) resumed on host: h (uuid: h-uuid), domid: 12"
     (body ~__context ~vm (Resumed {host})) ;
-  check "resume_on" "VM 'vm' (uuid: vm-uuid) resumed on host: h (uuid: h-uuid)"
+  check "resume_on"
+    "VM 'vm' (uuid: vm-uuid) resumed on host: h (uuid: h-uuid), domid: 12"
     (body ~__context ~vm (Resumed {host})) ;
   check "pool_migrate"
     "VM 'vm' (uuid: vm-uuid) migrated from host 'src' (uuid: src-uuid) to host \
-     'h' (uuid: h-uuid)"
+     'h' (uuid: h-uuid), domid: 12"
     (body ~__context ~vm (Migrated {source= source_host; destination= host})) ;
   check "migrate_send"
     "VM 'vm' (uuid: vm-uuid) migrated from host 'src' (uuid: src-uuid) to host \
-     'h' (uuid: h-uuid)"
+     'h' (uuid: h-uuid), domid: 12"
     (body ~__context ~vm (Migrated {source= source_host; destination= host}))
 
 let test = [("Message bodies", `Quick, test_bodies)]
diff --git a/ocaml/xapi/vm_message.ml b/ocaml/xapi/vm_message.ml
index 3d29805523..6a61c79975 100644
--- a/ocaml/xapi/vm_message.ml
+++ b/ocaml/xapi/vm_message.ml
@@ -52,6 +52,20 @@ let message = function
   | Cloned _ ->
       Api_messages.vm_cloned
 
+(* Whether the event gives the VM a new domain *)
+let creates_domain = function
+  | Started _ | Resumed _ | Rebooted _ | Migrated _ ->
+      true
+  | Paused
+  | Unpaused
+  | Suspended
+  | Shutdown _
+  | Snapshotted _
+  | Checkpointed _
+  | Snapshot_reverted _
+  | Cloned _ ->
+      false
+
 let body ~__context ~vm event =
   let host_name self = Db.Host.get_name_label ~__context ~self in
   let host_uuid self = Db.Host.get_uuid ~__context ~self in
@@ -73,10 +87,15 @@ let body ~__context ~vm event =
         "shutdown"
     | Shutdown {forced= true} ->
         "shutdown forcibly"
-    | Rebooted {forced= false} ->
-        "rebooted cleanly"
-    | Rebooted {forced= true} ->
-        "rebooted forcibly"
+    | Rebooted {forced} ->
+        let host = Db.VM.get_resident_on ~__context ~self:vm in
+        Printf.sprintf "rebooted %s, host: %s (uuid: %s)"
+          ( if forced then
+              "forcibly"
+            else
+              "cleanly"
+          )
+          (host_name host) (host_uuid host)
     | Migrated {source; destination} ->
         Printf.sprintf
           "migrated from host '%s' (uuid: %s) to host '%s' (uuid: %s)"
@@ -94,10 +113,16 @@ let body ~__context ~vm event =
         Printf.sprintf "cloned (new uuid: %s)"
           (Db.VM.get_uuid ~__context ~self:clone)
   in
-  Printf.sprintf "VM '%s' (uuid: %s) %s"
+  let domid =
+    if creates_domain event then
+      Printf.sprintf ", domid: %Ld" (Db.VM.get_domid ~__context ~self:vm)
+    else
+      ""
+  in
+  Printf.sprintf "VM '%s' (uuid: %s) %s%s"
     (Db.VM.get_name_label ~__context ~self:vm)
     (Db.VM.get_uuid ~__context ~self:vm)
-    what
+    what domid
 
 let create ~__context ~vm event =
   let body = body ~__context ~vm event in
