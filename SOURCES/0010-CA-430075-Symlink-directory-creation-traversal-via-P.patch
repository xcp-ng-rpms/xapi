diff --git a/ocaml/tests/test_message.ml b/ocaml/tests/test_message.ml
new file mode 100644
index 0000000000..b2b768d1f5
--- /dev/null
+++ b/ocaml/tests/test_message.ml
@@ -0,0 +1,215 @@
+(*
