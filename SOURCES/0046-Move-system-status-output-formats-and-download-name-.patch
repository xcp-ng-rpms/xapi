+module Output = struct
+  (** The output formats of xen-bugtool *)
+  type t = Tar | TarBz2 | Zip
+
+  let of_string = function
+    | "tar" ->
+        Some Tar
+    | "tar.bz2" ->
+        Some TarBz2
+    | "zip" ->
+        Some Zip
+    | _ ->
+        None
+
+  let to_extension = function
+    | Tar ->
+        "tar"
+    | TarBz2 ->
+        "tar.bz2"
+    | Zip ->
+        "zip"
+
+  let to_mime = function
+    | Tar ->
+        "application/x-tar"
+    | TarBz2 ->
+        "application/x-bzip2"
+    | Zip ->
+        "application/zip"
+end
+
+let make_filename ~hostname ~output =
+  let timestamp = Ptime_clock.now () |> Ptime.to_rfc3339 ~tz_offset_s:0 in
+  Printf.sprintf "system_status-%s-%s.%s" timestamp hostname
+    (Output.to_extension output)
