From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrii Sultanov <andriy.sultanov@vates.tech>
Date: Mon, 2 Nov 2026 10:52:48 +0000
Subject: [PATCH] CA-430073: VM.create bypasses RBAC on HA restart priority and
 appliance

VM.create only needs the VM admin role, but it takes a whole VM record,
including fields whose setters need a higher role. Two of them are
checked in this PR:

  - ha_restart_priority: a VM with "restart" is protected by HA and takes
    resources from the pool's point of view.
  - appliance: is managed from pool's point of view as well.

There are other VM fields which currently require higher role. But one
of them, ha_always_run, is deprecated. Others seem not necessary to be
managed by higher role, or from the pool's point of view.

This is CVE-2026-102706, part of XSA-530.

Signed-off-by: Ming Lu <ming.lu@citrix.com>
Reviewed-by: Andrii Sultanov <andriy.sultanov@vates.tech>
---
 ocaml/xapi/helpers.ml         | 25 +++++++++++++++++++++++++
 ocaml/xapi/import.ml          |  4 ++++
 ocaml/xapi/xapi_vm.ml         |  4 ++++
 ocaml/xapi/xapi_vm_clone.ml   | 11 +++++++++++
 ocaml/xapi/xapi_vm_helpers.ml |  4 ++++
 5 files changed, 48 insertions(+)

diff --git a/ocaml/xapi/helpers.ml b/ocaml/xapi/helpers.ml
index 1b5269c0d..15ace5db0 100644
--- a/ocaml/xapi/helpers.ml
+++ b/ocaml/xapi/helpers.ml
@@ -2710,6 +2710,31 @@ let assert_map_with_rbac ~__context ~match_protected ~object_name ~field_name
             )
         )
 
+(* With similar purpose of assert_map_with_rbac, check if setting a non-default
+   value on a field of an object is allowed. *)
+let assert_field_value_with_rbac ~__context ~object_name ~field_name ~is_default
+    =
+  if not is_default then
+    let action = Printf.sprintf "%s.set_%s" object_name field_name in
+    let permission = String.lowercase_ascii action in
+    match original_session ~__context with
+    | Ok None ->
+        ()
+    | Ok (Some session_id) ->
+        if not (Rbac.is_access_allowed ~__context ~session_id ~permission) then
+          raise
+            (Rbac.disallowed_permission_exn ~extra_dmsg:"" ~extra_msg:""
+               ~__context ~permission ~action
+            )
+    | Error () ->
+        raise
+          Api_errors.(
+            Server_error
+              ( rbac_permission_denied
+              , [action; "cannot determine the originating session"]
+              )
+          )
+
 let ldaps_enabled_in_config ~config =
   match List.assoc_opt "ldaps" config with
   (* Default to false, true iff v = true (case-insensitive) *)
