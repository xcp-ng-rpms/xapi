From e381b0f40ca92ab0f453220ec078c79c06879bad Mon Sep 17 00:00:00 2001
From: Julian Vetter <julian.vetter@vates.tech>
Date: Mon, 20 Jul 2026 10:59:55 +0200
Subject: [PATCH] xenopsd/xc: pass the guest ramdisk through as an ARM boot
 module

build_arm_info never had a modules field, so the BuildARM case in
Domain.build always called xenguest_args_pvh with ~modules:[] regardless
of what was configured on the VM. Any ramdisk set via PV-ramdisk was
silently dropped before it ever reached xenguest, so ARM guests booted
with no initrd and panicked unable to mount root.

Add modules to build_arm_info, thread it through the BuildARM build case
instead of the hardcoded ~modules:[], and populate it from
direct.ramdisk when constructing the ARM builder_spec_info in
xenops_server_xen.ml. This is almost the same code already used for
the PVH {boot = Direct _} case.

Signed-off-by: Julian Vetter <julian.vetter@vates.tech>
---
 ocaml/xenopsd/xc/domain.ml            | 12 ++++++++----
 ocaml/xenopsd/xc/domain.mli           |  6 +++++-
 ocaml/xenopsd/xc/xenops_server_xen.ml | 14 +++++++++++++-
 3 files changed, 26 insertions(+), 6 deletions(-)

diff --git a/ocaml/xenopsd/xc/domain.ml b/ocaml/xenopsd/xc/domain.ml
index e1bf96fdb..8eb36f2d0 100644
--- a/ocaml/xenopsd/xc/domain.ml
+++ b/ocaml/xenopsd/xc/domain.ml
@@ -149,7 +149,12 @@ type build_pvh_info = {
 }
 [@@deriving rpcty]
 
-type build_arm_info = {cmdline: string (* ...... *)} [@@deriving rpcty]
+type build_arm_info = {
+    cmdline: string
+  ; modules: (string * string option) list
+        (** list of modules plus optional cmdlines *)
+}
+[@@deriving rpcty]
 
 type builder_spec_info =
   | BuildHVM of build_hvm_info
@@ -1520,18 +1525,17 @@ let build (task : Xenops_task.task_handle) ~xc ~xs ~store_domid ~console_domid
         , [("rtc/timeoffset", timeoffset)]
         , `pvh
         )
-    | BuildARM {cmdline} ->
+    | BuildARM {cmdline; modules} ->
         let memory =
           Memory.Linux.full_config static_max_mib 0 target_mib vcpus 1.0
         in
         let store_port, console_port, numa_placement =
           build_pre ~xc ~xs ~memory ~vcpus ~hard_affinity domid
         in
-        (* TODO modules *)
         let store_mfn, console_mfn =
           let args =
             xenguest_args_pvh ~domid ~store_port ~store_domid ~console_port
-              ~console_domid ~memory ~kernel ~cmdline ~modules:[]
+              ~console_domid ~memory ~kernel ~cmdline ~modules
               ~numa_placement
             @ force_arg
             @ extras
diff --git a/ocaml/xenopsd/xc/domain.mli b/ocaml/xenopsd/xc/domain.mli
index 9831f5d31..90daba819 100644
--- a/ocaml/xenopsd/xc/domain.mli
+++ b/ocaml/xenopsd/xc/domain.mli
@@ -118,7 +118,11 @@ val typ_of_build_pvh_info : build_pvh_info Rpc.Types.typ
 
 val build_pvh_info : build_pvh_info Rpc.Types.def
 
-type build_arm_info = {cmdline: string (* ...... *)}
+type build_arm_info = {
+    cmdline: string
+  ; modules: (string * string option) list
+        (** list of modules plus optional cmdlines *)
+}
 
 val build_arm_info : build_arm_info Rpc.Types.def
 
diff --git a/ocaml/xenopsd/xc/xenops_server_xen.ml b/ocaml/xenopsd/xc/xenops_server_xen.ml
index dad8b6309..5c9c0924f 100644
--- a/ocaml/xenopsd/xc/xenops_server_xen.ml
+++ b/ocaml/xenopsd/xc/xenops_server_xen.ml
@@ -2597,7 +2597,19 @@ module VM = struct
               raise (Xenopsd_error No_bootable_device)
           | ARM {boot= Direct direct; _} ->
               let builder_spec_info =
-                Domain.(BuildARM {cmdline= direct.cmdline})
+                Domain.(
+                  BuildARM
+                    {
+                      cmdline= direct.cmdline
+                    ; modules=
+                        ( match direct.ramdisk with
+                        | Some r ->
+                            [(r, None)]
+                        | None ->
+                            []
+                        )
+                    }
+                )
               in
               (make_build_info direct.kernel builder_spec_info, "")
         in
-- 
2.53.0

